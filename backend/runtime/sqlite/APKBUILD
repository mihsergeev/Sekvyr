# Maintainer: Sekvyr Project
# Derived from Alpine 3.24 main/sqlite; retain its build flags and legacy SONAME.
maintainer="Sekvyr Project <maintainer@sekvyr.invalid>"
pkgname=sqlite
pkgver=3.54.1
pkgrel=0
pkgdesc="C library that implements an SQL database engine"
url="https://www.sqlite.org/"
arch="all"
license="blessing"
depends_dev="$pkgname=$pkgver-r$pkgrel"
makedepends_host="readline-dev"
subpackages="$pkgname-static $pkgname-doc $pkgname-dev $pkgname-libs"
_ver=3540100
source="https://www.sqlite.org/2026/sqlite-autoconf-$_ver.tar.gz
	https://www.sqlite.org/2026/sqlite-src-$_ver.zip
	"
builddir="$srcdir/$pkgname-autoconf-$_ver"
options="!check" # Autoconf distribution has no upstream test suite.
# secfixes:
#   3.54.1-r0:
#     - CVE-2026-119373
_amalgamation="-DSQLITE_ENABLE_FTS3_PARENTHESIS \
	-DSQLITE_ENABLE_COLUMN_METADATA \
	-DSQLITE_SECURE_DELETE \
	-DSQLITE_ENABLE_UNLOCK_NOTIFY \
	-DSQLITE_ENABLE_RTREE \
	-DSQLITE_ENABLE_GEOPOLY \
	-DSQLITE_USE_URI \
	-DSQLITE_ENABLE_DBSTAT_VTAB \
	-DSQLITE_SOUNDEX \
	-DSQLITE_MAX_VARIABLE_NUMBER=250000"

build() {
	export CFLAGS="${CFLAGS//-Os/-O2} $_amalgamation"

	CC_FOR_BUILD="$BUILDCC" \
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--enable-threadsafe \
		--enable-readline \
		--with-readline-header="$CBUILDROOT"/usr/include/readline/readline.h \
		--enable-session \
		--enable-static \
		--enable-fts3 \
		--enable-fts4 \
		--enable-fts5 \
		--soname=legacy
	make
}

package() {
	make DESTDIR="$pkgdir" install
	install -Dm644 "$srcdir"/$pkgname-src-$_ver/LICENSE.md \
		"$pkgdir"/usr/share/licenses/$pkgname/LICENSE.md
}

libs() {
	default_libs
	# The runtime ships only this split package, so include the upstream license.
	install -Dm644 "$srcdir"/$pkgname-src-$_ver/LICENSE.md \
		"$subpkgdir"/usr/share/licenses/$subpkgname/LICENSE.md
}

sha512sums="
