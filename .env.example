# --- Required (the panel REFUSES TO START with empty or default secrets) ---
#
# docker compose reads this file and substitutes $NAME inside values. A value
# with a "$" in it, a password for example, goes in single quotes, otherwise
# part of it silently disappears: SEKVYR_ADMIN_PASSWORD='my$secret-pass-2026'.

# The panel owner: the first sign-in. The password here is only the INITIAL
# one: later it is changed in the UI and is not synced back from here. At least
# 12 characters.
SEKVYR_ADMIN_USER=admin
SEKVYR_ADMIN_PASSWORD=

# The sign-in token secret, 32+ random characters:
#   openssl rand -hex 32
# With a weak secret anyone could sign themselves an owner token, so the panel
# does not start with one.
SEKVYR_JWT_SECRET=

# The PostgreSQL password (used only inside the compose network).
SEKVYR_DB_PASSWORD=

# Emergency sign-in: 1 resets the owner password to SEKVYR_ADMIN_PASSWORD and
# turns off two-factor authentication on the next start. For when both the
# password and the second factor are lost. After signing in set it back to 0
# and restart.
# The reset happens once per password value: a start with the same
# SEKVYR_ADMIN_PASSWORD does not repeat it, the log only warns. For another
# reset set a different SEKVYR_ADMIN_PASSWORD here.
SEKVYR_ADMIN_PASSWORD_RESET=0

# Where the base compose publishes the panel on the host. Localhost only by
# default: a reverse proxy with HTTPS opens it to the outside.
SEKVYR_BIND=127.0.0.1:8080

# --- The root key ---

# Opening the vault on start. Empty: the panel comes up SEALED and waits for
# the shares; this is the default and the strongest mode. Setting it makes
# sense only for a vault created with a single key.
#
# A file is better than a variable: variables show in `docker inspect` and in
# the process environment, while a file can have mode 0400 and its own owner.
# Keep it OUTSIDE the database volume, or a backup carries the key away
# together with the ciphertext and the encryption becomes decoration.
# Set SEKVYR_ROOT_KEY_FILE=/secret/root.key and the Vault section gets the
# "Remember the key on the server" button: the panel saves the key itself and
# comes up without manual input. /secret is a directory apart from the database
# volume exactly so that a backup does not take the key along.
SEKVYR_ROOT_KEY_FILE=
SEKVYR_ROOT_KEY=

# The panel time zone: the audit log and server timestamps are shown in it.
# UTC by default; set your own, Europe/Berlin for example.
SEKVYR_TIMEZONE=UTC

# The language of the ops/ scripts and their alerts: ru or en. Empty: by the
# locale, otherwise English. quickstart.sh sets en, quickstart-ru.sh sets ru.
SEKVYR_LANG=

# How many trusted proxies stand in front of the backend. 1: the base compose
# (only the frontend nginx), 2: with Caddy or your own proxy in front. It
# decides whose address gets into the audit log and the sign-in limiter.
SEKVYR_TRUSTED_PROXY_HOPS=1

# The public address of the panel, with the scheme. The server connect command
# and the links in alerts are built from it, so every installation needs it.
SEKVYR_PANEL_URL=https://sekvyr.example.com

# --- Only for compose.caddy.yml ---

# Behind caddy-docker-proxy the panel runs from several files. The line below
# makes ops/update.sh and any "docker compose up" take all of them: without it
# the frontend is recreated without caddy, and the panel disappears from the
# outside. Building from source:
# COMPOSE_FILE=compose.yml:compose.caddy.yml
# Released images from GHCR:
# COMPOSE_FILE=compose.yml:compose.ghcr.yml:compose.caddy.yml

# The existing docker network caddy-docker-proxy watches.
SEKVYR_CADDY_NETWORK=caddy

# The panel domain (TLS at the edge).
SEKVYR_DOMAIN=sekvyr.example.com

# Addresses allowed into the ADMIN UI, space-separated. The machine API
# (/api/v1/machine/*) stays open to everyone: that is a separate block in
# compose.caddy.yml.
# CAREFUL: an empty value forbids nobody, and the panel is open to the world.
# For a secrets vault set your addresses or keep the panel behind a VPN.
SEKVYR_ALLOW_IPS=203.0.113.10 198.51.100.23

# --- Only for compose.ghcr.yml ---

# The version of the released images. It must match the repository next to
# them: quickstart and ops/update.sh set it themselves. By hand, it is the tag
# the repository is checked out on, without the "v" (git describe --tags).
# SEKVYR_IMAGE_TAG=

# --- Optional ---

# Database and role names (sekvyr for a new installation).
SEKVYR_DB_NAME=sekvyr
SEKVYR_DB_USER=sekvyr

# Sign-in token lifetime, minutes (720 by default).
SEKVYR_JWT_TTL_MINUTES=720

# --- Alerts and maintenance ---

# The panel reports what cannot be learned later: the vault was sealed or
# opened, sign-in was blocked after a burst of attempts, an emergency archive
# was built, the audit chain stopped checking out. The Maintenance section of
# the UI can override these values; what is set here is not erased from there.
# The maintenance scripts (ops/backup.sh, ops/panel-watchdog.sh) do not read
# them from here: they take the channel from data/heartbeat, which the running
# panel rewrites every minute, so the watchdog can call for help after the
# panel is gone. A panel that has never come up has written no heartbeat, and
# the watchdog has nobody to send a message to.
SEKVYR_ALERT_TELEGRAM_TOKEN=
SEKVYR_ALERT_TELEGRAM_CHAT=
# A Bot API mirror for networks where api.telegram.org is unreachable.
SEKVYR_ALERT_TELEGRAM_API=
# The webhook, the Bot API mirror above and the audit receiver below are
# addresses the panel calls itself. Saved in the UI, an address is checked:
# https only and only a public address (backend/app/urlguard.py). Values from
# this file are taken as is.
SEKVYR_ALERT_WEBHOOK=

# Environments whose changes are worth a separate message, space-separated.
# Empty: no such messages. A message carries the place, the key name and the
# author; it has no value, just as the audit log has none.
SEKVYR_ALERT_ON_ENVS=prod production

# Where the COPY of the audit log goes. The hash chain in the database catches
# an edit in the middle but cannot stop the log from being cut off at the end:
# only a copy the database owner cannot reach protects from that. Empty: no
# copy.
SEKVYR_AUDIT_WEBHOOK=
SEKVYR_AUDIT_SHIP_INTERVAL=30

# The mark ops/backup.sh leaves: the panel only reads it and shows it in the
# Maintenance section. Empty: the panel does not watch the backup and does not
# notice when it goes quiet.
SEKVYR_BACKUP_STATE_FILE=/data/backup.json
# How many hours of silence count as an incident.
SEKVYR_BACKUP_MAX_AGE_HOURS=48

# Settings of ops/backup.sh itself, the panel does not read them: where to put
# backups (backups/ in the panel directory by default), how many files to keep
# and where to send a copy with rsync.
# SEKVYR_BACKUP_DIR=
# SEKVYR_BACKUP_KEEP=14
# SEKVYR_BACKUP_OFFSITE=user@backup.example.com:/srv/sekvyr
