# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/

# Рантайм: база, ключи, бэкапы. В репозиторий не попадает НИЧЕГО из этого -
# здесь лежат чужие секреты, и один неудачный `git add .` стоит дороже проекта.
data/
*.db

# Исключение из правила выше: таблица "адрес -> страна" - не рантайм, а данные,
# которые едут вместе с кодом (см. backend/app/geoip.py).
!backend/app/data/
!backend/app/data/geoip.csv.gz

# Доли root-ключа и файл автораспечатывания: если они окажутся рядом с базой в
# одном коммите, вся схема шифрования превращается в декорацию.
*.key
*.unseal
unseal-shares.txt

# Каталог с корневым ключом и паролем бэкапов - то же самое, только целиком.
secret/

# Сами бэкапы: зашифрованы, но в репозитории им делать нечего.
backups/
*.sealed

# Локальный .env; шаблон остается
.env
.env.new
.env.local
.env.*.local
!.env.example

# IDE / OS
.idea/
.vscode/
.DS_Store

# бренд-архив: ассеты уже распакованы
*brand-kit*.zip

# Закрытый ключ подписи агента: он живет в менеджере паролей, а не здесь
agent-signing-key.txt
agent/build/
