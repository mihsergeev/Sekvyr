            }
          },
          "replicas": {
            "anyOf": [{"const": 0}, {"minimum": 2}]
          }
        }
      }
    }
  ],
  "definitions": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
